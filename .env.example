# Senha só do primeiro acesso: com a tabela de usuários vazia, arthurfoxinfo@gmail.com + esta senha cria o dono.
# Depois disso ela não vale mais para nada.
APP_PASSWORD=
# Segredo longo e aleatório para assinar a sessão (mínimo 32 caracteres)
APP_SECRET=
# Endereço de conexão do banco de dados
DATABASE_URL=
# Chave da API do Gemini. Com ela definida, aparecem o botão "Montar com o assistente" e o chat flutuante;
# sem ela, o painel fica como sempre foi.
GEMINI_API_KEY=
# Modelo usado pelo assistente. Opcional; padrão: gemini-3.8-flash
GEMINI_MODEL=
# Segredo que a Vercel envia na coleta diária do Radar (Authorization: Bearer)
CRON_SECRET=
# Chave da API do Resend para os avisos por e-mail (revisão de proposta, responsável no pipeline).
# Sem ela, nada é enviado e o painel funciona normalmente.
RESEND_API_KEY=
# Remetente dos avisos, no formato: FoxLicita Pro <avisos@seu-dominio.com.br> (domínio verificado no Resend)
RESEND_FROM=
# Endereço público do painel usado nos links dos e-mails. Padrão: https://licitapro.foxtisolutions.com.br
APP_URL=
